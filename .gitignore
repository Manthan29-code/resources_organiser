node_modules/
jspm_packages/

# Snowpack / Vite cache
.snowpack
.vite/

# TypeScript cache and build info
*.tsbuildinfo
.tscache

# Production build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/

# Environment variables & secrets (CRITICAL: never commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Stores, temp files, and caches
.npm
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache

# OS-specific metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

